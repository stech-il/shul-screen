# העתק ל-.env.local והשלם מ-Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# מנהל מערכת — בשרת (חובה בפרודקשן ליצירת חשבון ראשוני)
# PLATFORM_ADMIN_USER=superadmin
# PLATFORM_ADMIN_PASSWORD=choose-a-long-random-password

# בפיתוח מקומי בלבד — seed מקומי ל־Agency (לא נטען בבילד פרודקשן)
# VITE_PLATFORM_ADMIN_USER=superadmin
# VITE_PLATFORM_ADMIN_PASSWORD=ShulAdmin2026!

# מפתח API אופציונלי לאוטומציות / cron (Bearer או X-API-Key)
# PLATFORM_API_KEY=
# CLOUD_API_SECRET=

# SMS (sms4free) — אימות כניסה יומי למנהל מערכת (/admin)
# לפני שליחה ראשונה: אמתו את מספר השולח בדף השליחה באתר sms4free.
# SMS4FREE_KEY=KPk4nOg7K
# SMS4FREE_USER=0524521527
# SMS4FREE_PASS=סיסמת_החשבון_באתר
# SMS4FREE_SENDER=0524521527
# PLATFORM_SMS_TO=0524521527


# סוד webhook של SUMIT (חובה בפרודקשן)
# BILLING_WEBHOOK_SECRET=

# סוד לקריאות cron (התראות / purge ניסיונות)
# CRON_SECRET=

# CORS — רשימת origins מופרדת בפסיקים (בנוסף ל־PUBLIC_ORIGIN)
# CORS_ORIGINS=http://localhost:5173

# Google Sign-In (OAuth 2.0 Web Client ID מ-Google Cloud Console)
# גם בבילד (VITE_) וגם בשרת (GOOGLE_CLIENT_ID) — אותו Client ID
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Authorized JavaScript origins: https://www.screensmart.co.il ו־http://localhost:5173

# מדיה: צור Storage bucket ציבורי בשם shul-media (ראה supabase/schema.sql)

# אופציונלי — פרוקסי oref בפרודקשן (nginx / cloud function עם IP ישראלי)
# VITE_OREF_PROXY_URL=/api/oref/alerts

# PUBLIC_ORIGIN=https://www.screensmart.co.il
# (קישורי איפוס סיסמה במייל — ברירת מחדל screensmart.co.il)

# SMTP — התראות מייל (ניסיון, תשלום, אזהרות, איפוס סיסמה)
# SMTP קלאסי: תיבת מייל + סיסמה מהדומיין שלך.
# חשוב: SMTP_USER ו־MAIL_FROM חייבים להיות באותו דומיין
# (למשל שניהם @landing-p.co.il) — אחרת הספק מחזיר 550 Domain mismatch.
#
# דוגמה נכונה:
#   SMTP_HOST=mail.landing-p.co.il
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=noreply@landing-p.co.il
#   SMTP_PASS=סיסמת_התיבה
#   MAIL_FROM=screensmart <noreply@landing-p.co.il>
#   MAIL_REPLY_TO=support@landing-p.co.il
#
# אם MAIL_FROM בדומיין אחר — המערכת תתקן אוטומטית לכתובת של SMTP_USER.
# אם הספק דורש SSL ישיר (פורט 465): SMTP_PORT=465 ו־SMTP_SECURE=true
# SMTP גם שולח התראות על פניות חדשות מהאתר (למנהל, אישור לפונה, ולמייל בית הכנסת).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_REPLY_TO=
