# העתק ל-.env.local והשלם מ-Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# מנהל מערכת — חובה ליצירת בתי כנסת חדשים
VITE_PLATFORM_ADMIN_USER=superadmin
VITE_PLATFORM_ADMIN_PASSWORD=ShulAdmin2026!

# מדיה: צור Storage bucket ציבורי בשם shul-media (ראה supabase/schema.sql)

# אופציונלי — פרוקסי oref בפרודקשן (nginx / cloud function עם IP ישראלי)
# VITE_OREF_PROXY_URL=/api/oref/alerts

# SMTP — התראות מייל (ניסיון, תשלום, אזהרות)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password-here
# MAIL_FROM=screensmart <your@gmail.com>
# MAIL_REPLY_TO=support@example.com
