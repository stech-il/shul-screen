# העתק ל-.env.local והשלם מ-Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# מנהל מערכת — חובה ליצירת בתי כנסת חדשים
VITE_PLATFORM_ADMIN_USER=superadmin
VITE_PLATFORM_ADMIN_PASSWORD=ShulAdmin2026!

# מדיה: צור Storage bucket ציבורי בשם shul-media (ראה supabase/schema.sql)

# אופציונלי — פרוקסי oref בפרודקשן (nginx / cloud function עם IP ישראלי)
# VITE_OREF_PROXY_URL=/api/oref/alerts

# SMTP — התראות מייל (ניסיון, תשלום, אזהרות)
# עובד עם כל ספק SMTP (לא חובה Gmail). דוגמאות נפוצות:
#   Resend:      SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=re_xxx
#   Brevo:       SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   Mailgun:     SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587
#   Amazon SES:  SMTP_HOST=email-smtp.eu-central-1.amazonaws.com  SMTP_PORT=587
#   אחסון פרטי: SMTP_HOST=mail.yourdomain.com  SMTP_PORT=587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=screensmart <noreply@yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com
