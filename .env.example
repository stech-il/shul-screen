# העתק ל-.env.local והשלם מ-Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# מנהל מערכת — חובה ליצירת בתי כנסת חדשים
VITE_PLATFORM_ADMIN_USER=superadmin
VITE_PLATFORM_ADMIN_PASSWORD=ShulAdmin2026!

# מדיה: צור Storage bucket ציבורי בשם shul-media (ראה supabase/schema.sql)

# אופציונלי — פרוקסי oref בפרודקשן (nginx / cloud function עם IP ישראלי)
# VITE_OREF_PROXY_URL=/api/oref/alerts

# SMTP — התראות מייל (ניסיון, תשלום, אזהרות)
# SMTP קלאסי בלבד: כתובת מייל + סיסמה מהדומיין / האחסון שלך (לא מפתח API).
# דוגמה (cPanel / אחסון ישראלי / Microsoft 365):
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=noreply@yourdomain.com
#   SMTP_PASS=סיסמת_תיבת_המייל
#   MAIL_FROM=screensmart <noreply@yourdomain.com>
#   MAIL_REPLY_TO=support@yourdomain.com
# אם הספק דורש SSL ישיר (פורט 465): SMTP_PORT=465 ו־SMTP_SECURE=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_REPLY_TO=
