# העתק ל-.env.local והשלם מ-Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# מנהל מערכת — חובה ליצירת בתי כנסת חדשים
VITE_PLATFORM_ADMIN_USER=superadmin
VITE_PLATFORM_ADMIN_PASSWORD=ShulAdmin2026!

# מדיה: צור Storage bucket ציבורי בשם shul-media (ראה supabase/schema.sql)

# אופציונלי — פרוקסי oref בפרודקשן (nginx / cloud function עם IP ישראלי)
# VITE_OREF_PROXY_URL=/api/oref/alerts

# SMTP — התראות מייל (ניסיון, תשלום, אזהרות)
# SMTP קלאסי: תיבת מייל + סיסמה מהדומיין שלך.
# חשוב: SMTP_USER ו־MAIL_FROM חייבים להיות באותו דומיין
# (למשל שניהם @landing-p.co.il) — אחרת הספק מחזיר 550 Domain mismatch.
#
# דוגמה נכונה:
#   SMTP_HOST=mail.landing-p.co.il
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=noreply@landing-p.co.il
#   SMTP_PASS=סיסמת_התיבה
#   MAIL_FROM=screensmart <noreply@landing-p.co.il>
#   MAIL_REPLY_TO=support@landing-p.co.il
#
# אם MAIL_FROM בדומיין אחר — המערכת תתקן אוטומטית לכתובת של SMTP_USER.
# אם הספק דורש SSL ישיר (פורט 465): SMTP_PORT=465 ו־SMTP_SECURE=true
# SMTP גם שולח התראות על פניות חדשות מהאתר (למנהל, אישור לפונה, ולמייל בית הכנסת).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_REPLY_TO=
